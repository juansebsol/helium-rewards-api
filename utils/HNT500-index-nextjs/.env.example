# Nexus (required)
NEXUS_BASE_URL=https://nexus.fractals.finance
NEXUS_API_KEY=
NEXUS_TOKEN=

# Index settings
INDEX_SIZE=500
WEIGHT_MODE=earnings
INDEX_HISTORY_DAYS=30
COINGECKO_COIN_ID=helium

# SQLite file (created automatically)
SQLITE_PATH=./data/hnt500.db

# Cron — standard cron syntax (default: every hour at :00)
CRON_SCHEDULE=0 */1 * * *

# Run a full/partial build when the server starts
RUN_BUILD_ON_START=true

# Optional: protect POST /api/rebuild (leave empty to disable rebuild endpoint)
REBUILD_SECRET=

# Throttle Nexus paging (ms)
TOP_EARNERS_PAGE_DELAY_MS=400
TOP_EARNERS_DAY_DELAY_MS=350
